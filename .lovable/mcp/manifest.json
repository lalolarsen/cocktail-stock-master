  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rboiblptylnsgcciutrk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "stockia",
      "version": "0.1.0",
      "title": "STOCKIA"
